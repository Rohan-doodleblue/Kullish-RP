      "get": {
        "summary": "Get Daily LLM Usage",
        "description": "Get LLM usage statistics for a specific date",
        "tags": ["LLM Usage Tracking"],
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "description": "Date in YYYY-MM-DD format",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-07-30"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daily usage statistics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
