{
  "openapi": "3.0.0",
  "info": {
    "title": "Automated Assessment & Scoring API",
    "description": "A Flask-based API that provides automated assessment generation and scoring using OpenAI GPT-3.5. This system reduces teacher workload by 50% in grading while providing consistent, unbiased scoring and instant feedback.",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Development server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token for user authentication. Include 'Bearer ' prefix followed by the token."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T10:30:00"
          },
          "service": {
            "type": "string",
            "example": "Automated Assessment API"
          }
        }
      },
      "TokenUsageResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2024-01-15"
          },
          "tokens_used": {
            "type": "integer",
            "example": 1250
          },
          "tokens_remaining": {
            "type": "integer",
            "example": 23750
          },
          "limit": {
            "type": "integer",
            "example": 25000
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "usage": {
            "$ref": "#/components/schemas/TokenUsageResponse"
          }
        }
      },
      "TitleEnhancementRequest": {
        "type": "object",
        "required": ["original_title"],
        "properties": {
          "original_title": {
            "type": "string",
            "description": "Original title to enhance"
          },
          "context_type": {
            "type": "string",
            "description": "Context type for enhancement",
            "default": "general"
          },
          "domain": {
            "type": "string",
            "description": "Domain for enhancement",
            "default": "general"
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum length for enhanced titles",
            "default": 50
          },
          "style_preference": {
            "type": "string",
            "description": "Style preference for enhancement",
            "default": "professional"
          }
        }
      },
      "TitleEnhancementResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "titles": {
            "type": "object",
            "properties": {
              "title1": {"type": "string"},
              "title2": {"type": "string"},
              "title3": {"type": "string"}
          }
        }
      }
    },
      "TitleRegenerationRequest": {
        "type": "object",
        "required": ["original_title"],
        "properties": {
          "original_title": {
            "type": "string",
            "description": "Original title to enhance"
          },
          "context_type": {
            "type": "string",
            "description": "Context type for enhancement",
            "default": "general"
          },
          "domain": {
            "type": "string",
            "description": "Domain for enhancement",
            "default": "general"
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum length for enhanced titles",
            "default": 50
          },
          "style_preference": {
            "type": "string",
            "description": "Style preference for enhancement",
            "default": "professional"
          },
          "exclude_previous": {
            "type": "boolean",
            "description": "Whether to exclude previous suggestions",
            "default": true
          }
        }
      },
      "MessageEnhancementRequest": {
        "type": "object",
        "required": ["original_message"],
        "properties": {
          "original_message": {
            "type": "string",
            "description": "Original message to enhance"
          },
          "context_type": {
            "type": "string",
            "description": "Context type for enhancement",
            "default": "general"
          },
          "domain": {
            "type": "string",
            "description": "Domain for enhancement",
            "default": "general"
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum length for enhanced messages",
            "default": 500
          },
          "style_preference": {
            "type": "string",
            "description": "Style preference for enhancement",
            "default": "professional"
          },
          "tone": {
            "type": "string",
            "description": "Tone for enhancement",
            "default": "professional"
          }
        }
      },
      "MessageEnhancementResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "messages": {
            "type": "object",
            "properties": {
              "message1": {"type": "string"},
              "message2": {"type": "string"},
              "message3": {"type": "string"}
                }
              }
            }
          },
      "MessageRegenerationRequest": {
        "type": "object",
        "required": ["original_message"],
        "properties": {
          "original_message": {
            "type": "string",
            "description": "Original message to enhance"
          },
          "context_type": {
            "type": "string",
            "description": "Context type for enhancement",
            "default": "general"
          },
          "domain": {
            "type": "string",
            "description": "Domain for enhancement",
            "default": "general"
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum length for enhanced messages",
            "default": 500
          },
          "style_preference": {
            "type": "string",
            "description": "Style preference for enhancement",
            "default": "professional"
          },
          "tone": {
            "type": "string",
            "description": "Tone for enhancement",
            "default": "professional"
          },
          "exclude_previous": {
            "type": "boolean",
            "description": "Whether to exclude previous suggestions",
            "default": true
          }
        }
      },
      "CompleteAnnouncementRequest": {
        "type": "object",
        "required": ["title", "message_body"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Original title"
          },
          "message_body": {
            "type": "string",
            "description": "Original message body"
          },
          "announcement_type": {
            "type": "string",
            "description": "Type of announcement",
            "default": "General Notice"
          },
          "target_audience": {
            "type": "string",
            "description": "Target audience",
            "default": "All"
          },
          "tone": {
            "type": "string",
            "description": "Desired tone",
            "default": "Professional"
          },
          "max_title_length": {
            "type": "integer",
            "description": "Maximum title length",
            "default": 20
          },
          "max_message_length": {
            "type": "integer",
            "description": "Maximum message length",
            "default": 400
          },
          "include_suggestions": {
            "type": "boolean",
            "description": "Whether to include suggestions",
            "default": false
          }
        }
      },
      "AnnouncementCreationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
          }
        }
      }
    },
      "AnnouncementSuggestionsRequest": {
        "type": "object",
        "required": ["announcement_type", "target_audience"],
        "properties": {
          "announcement_type": {
            "type": "string",
            "description": "Type of announcement"
          },
          "target_audience": {
            "type": "string",
            "description": "Target audience"
          }
        }
      },
      "AnnouncementSuggestionsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "suggestions": {
            "type": "object",
            "properties": {
              "title_suggestions": {
                "type": "array",
                "items": {"type": "string"}
              },
              "message_body_suggestions": {
                "type": "array",
                "items": {"type": "string"}
              },
              "tone_suggestions": {
                "type": "array",
                "items": {"type": "string"}
                  }
                }
              }
            }
          },
      "LLMUsageSummaryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "total_usage": {
            "type": "object",
            "properties": {
              "total_text_requests": {"type": "integer"},
              "total_image_requests": {"type": "integer"},
              "total_tokens_used": {"type": "integer"},
              "total_cost_usd": {"type": "number"}
            }
          },
          "daily_usage": {
            "type": "object",
            "properties": {
              "text_requests": {"type": "integer"},
              "image_requests": {"type": "integer"},
              "tokens_used": {"type": "integer"},
              "cost_usd": {"type": "number"}
            }
          },
          "monthly_usage": {
            "type": "object",
            "properties": {
              "text_requests": {"type": "integer"},
              "image_requests": {"type": "integer"},
              "tokens_used": {"type": "integer"},
              "cost_usd": {"type": "number"}
              }
            }
          }
        }
      }
    },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Check if the API is running and healthy",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
                }
              }
            }
          },
    "/api/token-usage": {
      "get": {
        "summary": "Get Token Usage",
        "description": "Get current daily token usage statistics for OpenAI API",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Token usage statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenUsageResponse"
                }
              }
            }
          }
        }
      }
    },
